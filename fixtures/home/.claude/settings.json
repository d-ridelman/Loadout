{
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "alpha@mp": true,
    "beta@mp": false,
    "dup@mp": true,
    "ghost@mp": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node {HOME}/hooks/guard.mjs --token FAKE-SECRET-HOOK", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "TOKEN=FAKE-SECRET-HOOKENV node {HOME_UPPER}/hooks/post.mjs --header \"Authorization: Bearer FAKE-SECRET-HOOKHDR\"" }
        ]
      }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "pwsh -File {HOME}/hooks/sweep.ps1" } ] }
    ]
  }
}
