{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "read|write|bash|pwsh",
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/.claude/hooks/ctxkit --dsh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write|edit",
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/.claude/hooks/ctxkit --dsh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
