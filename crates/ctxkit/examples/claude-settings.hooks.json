{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"/path/to/.claude/hooks/ctxkit\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"/path/to/.claude/hooks/ctxkit\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
