{
  "context-toolkit": {
    "PreToolUse": [
      {
        "matcher": "read_file|write_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/.claude/hooks/context-toolkit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
