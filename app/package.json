{
  "name": "loadout-app",
  "version": "0.0.4",
  "private": true,
  "description": "Loadout: что загружено в ваших агентов",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "core": "cargo build --release --manifest-path ../Cargo.toml",
    "e2e": "npm run core && electron-vite build && node e2e/run.mjs",
    "bundle:ctxkit": "node scripts/bundle-ctxkit.mjs",
    "pack": "npm run core && node scripts/bundle-ctxkit.mjs && electron-vite build && electron-builder --win --dir",
    "pack:check": "node e2e/pack-check.mjs",
    "dist": "npm run core && node scripts/bundle-ctxkit.mjs && electron-vite build && electron-builder --win"
  },
  "author": "Loadout",
  "build": {
    "appId": "local.loadout.app",
    "productName": "Loadout",
    "directories": { "output": "dist" },
    "files": ["out/**", "package.json"],
    "extraResources": [
      { "from": "../target/release/loadout.exe", "to": "loadout.exe" },
      { "from": "build/icon.png", "to": "icon.png" },
      { "from": "build/ctxkit.exe", "to": "ctxkit.exe" }
    ],
    "asar": true,
    "publish": null,
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Loadout",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
