{
  "name": "loadout-app",
  "version": "1.1.0",
  "private": true,
  "description": "Plugins, MCP servers, skills and hooks of six AI coding clients in one matrix, with safe config edits",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/d-ridelman/Loadout" },
  "homepage": "https://github.com/d-ridelman/Loadout",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "core": "cargo build --release --manifest-path ../Cargo.toml",
    "e2e": "npm run core && node scripts/bundle-context-toolkit.mjs && electron-vite build && node e2e/run.mjs",
    "docs-shots": "npm run core && node scripts/bundle-context-toolkit.mjs && electron-vite build && node e2e/docs-shots.mjs",
    "bundle:context-toolkit": "node scripts/bundle-context-toolkit.mjs",
    "pack": "npm run core && node scripts/bundle-context-toolkit.mjs && node scripts/bundle-vcruntime.mjs && electron-vite build && electron-builder --win --dir --publish never",
    "pack:check": "node e2e/pack-check.mjs",
    "dist": "npm run core && node scripts/bundle-context-toolkit.mjs && node scripts/bundle-vcruntime.mjs && electron-vite build && electron-builder --win --publish never"
  },
  "author": "Loadout contributors",
  "build": {
    "appId": "local.loadout.app",
    "productName": "Loadout",
    "directories": { "output": "dist" },
    "files": ["out/**", "package.json"],
    "extraResources": [
      { "from": "../target/release/loadout.exe", "to": "loadout.exe" },
      { "from": "../target/release/loadout-ml.exe", "to": "loadout-ml.exe" },
      { "from": "build/vcruntime", "to": ".", "filter": ["*.dll"] },
      { "from": "../licenses", "to": "licenses", "filter": ["THIRD_PARTY_NOTICES.md", "onnxruntime-ThirdPartyNotices.txt"] },
      { "from": "build/icon.png", "to": "icon.png" },
      { "from": "build/context-toolkit.exe", "to": "context-toolkit.exe" }
    ],
    "asar": true,
    "electronLanguages": ["en-US", "ru"],
    "publish": { "provider": "github", "owner": "d-ridelman", "repo": "Loadout" },
    "win": {
      "icon": "build/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "${productName}.Setup.${version}.${ext}",
      "oneClick": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Loadout",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
